{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topic Desk Studio",
  "version": "0.2.2",
  "identifier": "com.dataelement.topicdesk.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1220,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "incognito": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first trend curation workspace",
    "longDescription": "Collect, search, track and curate trending topics in a private local database.",
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 720,
          "height": 440
        },
        "appPosition": {
          "x": 190,
          "y": 244
        },
        "applicationFolderPosition": {
          "x": 530,
          "y": 244
        }
      }
    }
  }
}
